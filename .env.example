# Dışarıya bağlanan host port (sunucuda 3000'i başkası kullanıyorsa değiştirin)
WA_HOST_PORT=3000

# API anahtarı — boş bırakılırsa auth devre dışı (PUBLIC SUNUCULARDA MUTLAKA DOLDUR!)
WA_API_KEY=gizli-anahtar-buraya

# Bağlantı koptuğunda kaç kez yeniden denensin
WA_MAX_RETRIES=10

# Log seviyesi: trace | debug | info | warn | error
LOG_LEVEL=info
